# --- LLM (pick one provider; format is "<provider>:<model>") ---
ANTHROPIC_API_KEY=
# LLM_MODEL=anthropic:claude-opus-5-5     # default when ANTHROPIC_API_KEY is set
# LLM_EFFORT=low                          # Claude effort: low | medium | high
# OPENAI_API_KEY=   with LLM_MODEL=openai:gpt-4.1
# GROQ_API_KEY=     with LLM_MODEL=groq:llama-3.3-70b-versatile

# --- Agent / safety limits ---
# MAX_GENERATION_ATTEMPTS=3   # self-correction loop size
# MAX_RESULT_ROWS=500
# QUERY_TIMEOUT_S=5
# MAX_INPUT_CHARS=4000
# HISTORY_TURNS=6
# RATE_LIMIT_PER_MIN=20       # per IP; 0 disables
# DB_PATH=data/sample.db
