# Copy to .env and fill in ONE provider. Never commit .env (it is git-ignored).
# Model format is "<provider>:<model>".

# --- Option A: GroqCloud free tier (default deployment) ---
GROQ_API_KEY=
LLM_MODEL=groq:openai/gpt-oss-120b
LLM_EFFORT=low                       # gpt-oss reasoning effort: low | medium | high

# --- Option B: Anthropic Claude (paid) ---
# ANTHROPIC_API_KEY=
# LLM_MODEL=anthropic:claude-opus-5-5

# --- Option C: OpenAI (paid) ---
# OPENAI_API_KEY=
# LLM_MODEL=openai:gpt-4.1

# --- Agent / safety limits (optional) ---
# MAX_GENERATION_ATTEMPTS=3   # self-correction loop size
# MAX_RESULT_ROWS=500
# QUERY_TIMEOUT_S=5
# MAX_INPUT_CHARS=4000
# HISTORY_TURNS=6
# RATE_LIMIT_PER_MIN=20       # per IP; 0 disables
# DB_PATH=data/sample.db
